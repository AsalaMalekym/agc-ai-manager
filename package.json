{
  "name": "agc-ai-manager",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check worker.js && node --check src/manager.js && node --check src/services.js && node --check src/news.js && npm test",
    "build": "wrangler deploy --dry-run --config wrangler.staging.toml",
    "dev": "wrangler dev --config wrangler.staging.toml",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1"
  }
}
